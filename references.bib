@article{kendon2026state,
  author   = {Kendon, Mike and Doherty, Amy and Hollis, Dan and Carlisle, Emily and Packman, Stephen and Rayner, Nick and Berthou, Ségolène and Barker, Lucy and Turner, Steve and Hannaford, Jamie and Jevrejeva, Svetlana and Matthews, Andrew and Williams, Joanne and Marshall, Alex and Sparks, Tim},
